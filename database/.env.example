# Пример конфигурации базы данных
# Скопируйте в .env и настройте

# if using locally
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/dbname

# if using DOCKER
# DATABASE_URL=postgresql+psycopg2://username:password@postgres:5432/dbname

# Базовые настройки
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD  # replace!
POSTGRES_DB=travel_ml
POSTGRES_HOST=postgres  # if using locally: localhost
POSTGRES_PORT=5432

# Настройки пула соединений
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# Дополнительные настройки
DEBUG=false
ENVIRONMENT=development  # development/staging/production